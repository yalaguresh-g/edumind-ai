# EduMind AI Lite - Backend Configuration
# Obtain your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended multimodal model: gemini-2.5-flash or gemini-2.0-flash or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Maximum upload file size in Megabytes (default 20MB)
MAX_UPLOAD_MB=20

